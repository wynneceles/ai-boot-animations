<!--
  托盘图标右键菜单。作为资源嵌在 AIBootAnimations.exe 里，由 TrayMenu 用 XamlReader 载入。
  和「启动设置」一个风格：白底圆角、柔和阴影，只有「启动设置」和「退出」两项。
  外圈 12 像素是透明的，留给阴影。
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="12"
      TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="13" TextElement.Foreground="#1F2329"
      TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid.Resources>
    <Style x:Key="Item" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#1F2329"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Padding="12,9">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F1F2FF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E4E7FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <!-- 阴影单独一层，文字不跟着被处理 -->
  <Border Background="White" CornerRadius="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.2" Color="#000000"/>
    </Border.Effect>
  </Border>
  <Border Background="White" CornerRadius="12" BorderBrush="#E3E6EB" BorderThickness="1" Padding="6">
    <StackPanel MinWidth="164">
      <Button x:Name="OpenItem" Style="{StaticResource Item}">
        <StackPanel Orientation="Horizontal">
          <Image x:Name="OpenIcon" Width="20" Height="20" VerticalAlignment="Center"/>
          <TextBlock Text="启动设置" Margin="10,0,0,0" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Border Height="1" Background="#EEF0F3" Margin="8,4"/>
      <Button x:Name="QuitItem" Style="{StaticResource Item}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Width="20"
                     TextAlignment="Center" VerticalAlignment="Center" Foreground="#6B7280"/>
          <TextBlock Text="退出" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </Border>
</Grid>
