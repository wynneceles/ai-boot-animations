<?xml version="1.0" encoding="utf-8"?>
<!-- build.ps1 会把它复制成 AIBootAnimations.exe.config，和程序放在一起 -->
<configuration>
  <runtime>
    <!-- 让 WPF 跟着每块屏幕各自的 DPI 缩放（配合清单里的 PerMonitorV2）：浮层和「启动设置」换屏幕后大小、位置都对 -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
  </runtime>
</configuration>
